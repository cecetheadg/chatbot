# ============================================
# Chatbot L0027 - Configuration
# Copiez ce fichier vers .env et configurez les valeurs
# ============================================

# Application
APP_NAME="Chatbot L0027 - Statut des Agents de l'État"
DEBUG=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ============================================
# Base de données PostgreSQL
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=votre_mot_de_passe_securise
POSTGRES_DB=chatbot_l0027

# ============================================
# Cache Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600

# ============================================
# Vector Store Qdrant
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=loi_l0027
VECTOR_SIZE=1536

# ============================================
# LLM Providers (configurez au moins un)
# ============================================

# OpenAI (RECOMMANDÉ - requis pour les embeddings)
OPENAI_API_KEY=sk-votre-cle-openai
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-votre-cle-anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514

# DeepSeek
DEEPSEEK_API_KEY=votre-cle-deepseek
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM par défaut (openai, anthropic, deepseek)
DEFAULT_LLM_PROVIDER=openai

# ============================================
# Configuration RAG
# ============================================
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
MAX_CONTEXT_LENGTH=4000

# ============================================
# Limites et sécurité
# ============================================
MAX_QUESTION_LENGTH=500
MAX_RESPONSE_LENGTH=2000
RATE_LIMIT_PER_MINUTE=30

# ============================================
# Chemins des données
# ============================================
DATA_DIR=./data
LAW_FILE=loi_L0027_enrichie.json
QA_FILE=qa_entrainement_L0027.json
